.global main

@ Syscalls follow the Linux ARM EABI: number in r7, arguments in r0-r2, result in r0.
@
@ Expected: "Hi" + newline on stdout, "Hi" + newline on stderr (red), then the process
@ exits with code 3. To check the error path, change `mov r7, #1` to
@ `mov r7, #2`: "Execution failed: Unsupported syscall 2".
main:
  movw r0, #0x6948     @ "Hi"
  movt r0, #0x000A     @ "\n"
  str r0, [sp, #-4]!   @ "Hi\n" now sits at sp
  mov r1, sp           @ r1 = buffer address
  mov r2, #3           @ r2 = length
  mov r7, #4           @ r7 = 4 (write)

  mov r0, #1           @ fd = 1 (stdout)
  svc #0               @ write(1, sp, 3), r0 = 3

  mov r0, #2           @ fd = 2 (stderr)
  svc #0               @ write(2, sp, 3), r0 = 3

  mov r7, #1           @ r7 = 1 (exit)
  svc #0               @ exit(3), r0 still holds the last write's byte count
  add r5, r5, #1       @ never executed
