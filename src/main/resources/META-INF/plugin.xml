<idea-plugin>
    <id>io.github.asmflow.assembly</id>

    <name>Assembly</name>
    <vendor>HKUST AsmFlow</vendor>
    <description>Various Assembly language support for the IntelliJ Platform. Part of the AsmFlow project.</description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.AssemblyBundle</resource-bundle>

    <actions>
        <action class="io.github.asmflow.assembly.armv7.actionSystem.editor.EditorShowMnemonicDocumentationAction"
            text="Show Mnemonic Documentation" icon="AllIcons.Toolwindows.Documentation">
            <add-to-group group-id="EditorPopupMenu" anchor="first" />
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="ARMv7_ASM"
            implementationClass="io.github.asmflow.assembly.armv7.annotation.ARMv7SemanticHighlightingAnnotator" />
        <colorSettingsPage implementation="io.github.asmflow.assembly.armv7.options.ARMv7ColorSettingsPage" />
        <completion.contributor language="ARMv7_ASM"
            implementationClass="io.github.asmflow.assembly.armv7.editorActions.ARMv7CompletionContributor" />
        <configurationType
            implementation="io.github.asmflow.assembly.execution.configurations.AssemblyRunConfigurationType" />
        <errorHandler implementation="io.github.asmflow.assembly.openapi.diagnostic.AssemblyErrorReportSubmitter" />
        <fileType name="ARMv7 Assembly" language="ARMv7_ASM"
            implementationClass="io.github.asmflow.assembly.armv7.ARMv7FileType" extensions="arm"
            fieldName="INSTANCE" />
        <lang.parserDefinition language="ARMv7_ASM"
            implementationClass="io.github.asmflow.assembly.armv7.ARMv7ParserDefinition" />
        <lang.syntaxHighlighterFactory language="ARMv7_ASM"
            implementationClass="io.github.asmflow.assembly.armv7.editor.colors.ARMv7SyntaxHighlighterFactory" />
        <quoteHandler className="io.github.asmflow.assembly.armv7.editorActions.ARMv7QuoteHandler"
            fileType="ARMv7 Assembly" />
        <toolWindow factoryClass="io.github.asmflow.assembly.armv7.toolWindows.ARMv7DocumentationToolWindowFactory"
            icon="AllIcons.Toolwindows.Documentation" anchor="right" id="ARMv7 Documentation" />
    </extensions>
</idea-plugin>
